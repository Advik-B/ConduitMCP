{
  "name": "conduit",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Conduit workspace root: hoists broker deps so repo-level dev scripts resolve them.",
  "workspaces": ["broker"],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "demo": "bun scripts/demo/record.ts",
    "pack:npm": "bun scripts/pack-npm.ts",
    "coverage": "bun scripts/coverage/report.ts",
    "coverage:check": "bun scripts/coverage/report.ts --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p broker",
    "ci:phases": "bun run handshake && bun run stress && bun run phase3 && bun run phase4 && bun run phase7 && bun run phase8 && bun run phase9 && bun run phase10 && bun run phase13 && bun run phase14 && bun run phase15 && bun run phase16 && bun run phase17 && bun run addon && bun run engine",
    "handshake": "bun tests/evals/startup_handshake.ts",
    "addon": "bun tests/evals/addon_install.ts",
    "engine": "bun tests/evals/engine_install.ts",
    "stress": "bun tests/evals/phase1_stress.ts",
    "phase2": "bun tests/evals/phase2_runtime.ts",
    "phase3": "bun tests/evals/phase3_editor.ts",
    "phase4": "bun tests/evals/phase4_headless.ts",
    "phase5": "bun tests/evals/phase5_debugger.ts",
    "phase6": "bun tests/evals/phase6_pixel.ts",
    "phase7": "bun tests/evals/phase7_parity.ts",
    "phase8": "bun tests/evals/phase8_runtime_parity.ts",
    "phase9": "bun tests/evals/phase9_project_tools.ts",
    "phase10": "bun tests/evals/phase10_targeting.ts",
    "phase13": "bun tests/evals/phase13_import.ts",
    "phase14": "bun tests/evals/phase14_shader.ts",
    "phase15": "bun tests/evals/phase15_plugins_i18n.ts",
    "phase16": "bun tests/evals/phase16_objects.ts",
    "phase17": "bun tests/evals/phase17_signals.ts",
    "phase18": "bun tests/evals/phase18_rendering_device.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "commander": "^15.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
